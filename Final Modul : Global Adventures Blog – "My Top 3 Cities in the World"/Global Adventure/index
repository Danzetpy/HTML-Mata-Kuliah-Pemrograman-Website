    <!-- ================= HALAMAN HOME ================= -->
    <div class="page active" id="home">
        <header>
            <h1>Journeys of Friendship: Exploring the World Together 🌍</h1>
            <p>Traveling with friends turns every street into a story. Join us as we revisit the three cities that stole our hearts and invite you to the adventures still waiting ahead.</p>
        </header>

        <main>
            <section class="slideshow">
                <h2>Our Top 3 Cities</h2>
                <figure>
