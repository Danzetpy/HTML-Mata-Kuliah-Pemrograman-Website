  function displayRegionInfo(regionId) {
    const info = jambiSubMapInfo[regionId];
    if (info) {
      alert(`Kategori: ${info.category}\nWilayah: ${info.region}\nPerairan/Sungai: ${info.river}\nBentang Alam: ${info.mountain}\nLandmark/Keunggulan: ${info.landmarks}`);
    } else {
      alert('Informasi sub-daerah belum tersedia.');
    }
  }

  document.querySelectorAll('area').forEach(area => {
    area.addEventListener('click', function() {
      const regionId = this.id;
      displayRegionInfo(regionId);
    });
  });

  const discoverLocationButton = document.getElementById('discoverLocation');
  discoverLocationButton.addEventListener('click', () => {
    if ("geolocation" in navigator) {
      navigator.geolocation.getCurrentPosition((position) => {
        const latitude = position.coords.latitude;
        const longitude = position.coords.longitude;
        
        let detectedId = 'jambi-kota';
        if (longitude < 101.8) {
          detectedId = 'sungai-penuh';
        } else if (longitude >= 101.8 && longitude < 102.8) {
          detectedId = 'bangko';
        } else if (longitude >= 102.8 && longitude < 103.3) {
          detectedId = 'muara-bulian';
        } else if (latitude > -1.0) {
          detectedId = 'kuala-tungkal';
        }
        
        displayRegionInfo(detectedId);
      }, (error) => {
        alert("Gagal mendeteksi lokasi: " + error.message);
      });
    } else {
      alert("Fitur geolokasi tidak didukung oleh browser Anda.");
    }
  });
